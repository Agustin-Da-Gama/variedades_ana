{
  "hosting": [
    {
      "site": "paginas-b6e4d",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.*/**",
        ".agent/**",
        ".git/**",
        ".firebase/**",
        "**/node_modules/**",
        "README.md",
        "imagenes/**",
        "assets/favicon.*",
        "assets/logo.svg",
        "assets/logo-oficial-transparent.png",
        "assets/fotos/nosotros-cocina-original.jpg",
        "assets/fotos/galeria-empanaditas-*",
        "assets/fotos/galeria-noquis-*",
        "assets/fotos/galeria-vareniques-*",
        "assets/fotos/galeria-milanesas-*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
          ]
        },
        {
          "source": "**/*.@(css|js|jpg|jpeg|png|webp|ico|svg)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
          ]
        },
        {
          "source": "**/*.@(html|json|xml|txt)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
          ]
        }
      ]
    },
    {
